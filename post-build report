#!/usr/bin/env bash
#
# Read-only EDB Postgres Advanced Server post-build validation.
#
# Runs 10 checks, writes results.tsv, dbportal_inventory.txt and an HTML report
# (with raw command evidence embedded) to OUTDIR, then emails the report via
# the local sendmail relay. Scratch files are deleted on exit.
#
# Environment overrides:
#   PGPORT, PG_SERVICE, EFM_SERVICE, EFM_BIN, EFM_CLUSTER,
#   OUTDIR, EMAIL_TO, EMAIL_FROM, SEND_EMAIL (yes|no)

set -uo pipefail
export LC_ALL=C

# =============================================================================
# Configuration
# =============================================================================
PORT=${PGPORT:-7432}
SERVICE=${PG_SERVICE:-edb-as-16}
EFM_SERVICE=${EFM_SERVICE:-edb-efm-4.10.service}
EFM_BIN=${EFM_BIN:-/usr/edb/efm-4.10/bin/efm}
EFM_CLUSTER=${EFM_CLUSTER:-efm}
EMAIL_TO=${EMAIL_TO:-dbarequest@firstcicizenbank.com}
EMAIL_FROM=${EMAIL_FROM:-}
SEND_EMAIL=${SEND_EMAIL:-yes}

# =============================================================================
# Environment detection
# =============================================================================
# Hostname naming policy: p = Production/DR, d = Development, q = QA, t = UAT.
# Unknown prefixes fail closed so Production/DR controls cannot be silently
# skipped.
HOST=$(hostname -f 2>/dev/null || hostname)
SHORT_HOST=${HOST%%.*}

case "${SHORT_HOST:0:1}" in
  [pP]) ENVIRONMENT=PRODUCTION_DR ;;
  [dD]) ENVIRONMENT=DEVELOPMENT ;;
  [qQ]) ENVIRONMENT=QA ;;
  [tT]) ENVIRONMENT=UAT ;;
  *)
    printf 'ERROR: Unknown hostname prefix for %s; cannot safely classify environment.\n' "$HOST" >&2
    exit 2
    ;;
esac
printf 'Detected environment: %s (host %s)\n' "$ENVIRONMENT" "$HOST"

is_prod_dr() { [[ "$ENVIRONMENT" == PRODUCTION_DR ]]; }

# =============================================================================
# Output files
# =============================================================================
OUTDIR=${OUTDIR:-"$PWD/postbuild-$(date +%Y%m%d-%H%M%S)"}
mkdir -p "$OUTDIR" || exit 1
chmod 700 "$OUTDIR"

# Kept in OUTDIR:
REPORT="$OUTDIR/results.tsv"                    # one line per check
INVENTORY="$OUTDIR/dbportal_inventory.txt"      # for manual DBPortal comparison
HTML_REPORT="$OUTDIR/postbuild_report.html"     # summary + embedded evidence

# Scratch files live in a private temp dir that is deleted on exit, so
# details.txt and evidence.txt never remain in OUTDIR.
WORKDIR=$(mktemp -d) || exit 1
trap 'rm -rf "$WORKDIR"' EXIT
DETAILS="$WORKDIR/details.txt"                  # supporting detail / stderr
EVIDENCE="$WORKDIR/evidence.txt"                # full command output

printf 'Check\tStatus\tDetails\n' > "$REPORT"
: > "$DETAILS"
: > "$EVIDENCE"
chmod 600 "$REPORT" "$DETAILS" "$EVIDENCE"

# =============================================================================
# Helpers
# =============================================================================

# record <check#> <PASS|FAIL|REVIEW|MANUAL|N/A> <details>
record() {
  printf '%s\t%s\t%s\n' "$1" "$2" "$3" | tee -a "$REPORT"
}

# Start a new titled block in details.txt.
section() {
  printf '\n### %s ###\n' "$1" >> "$DETAILS"
}

# Run a SQL statement quietly (tuples only); errors go to details.txt.
query() {
  psql -X -qAt -w -p "$PORT" -d edb -v ON_ERROR_STOP=1 -c "$1" 2>>"$DETAILS"
}

# --- Evidence helpers (print to screen and append to evidence.txt) -----------

evidence_section() {
  printf '\n========== %s ==========\n' "$1" | tee -a "$EVIDENCE"
}

# Run a command, echoing it (shell-quoted) and its output; flag non-zero exits.
evidence_run() {
  printf '\n$' | tee -a "$EVIDENCE"
  printf ' %q' "$@" | tee -a "$EVIDENCE"
  printf '\n' | tee -a "$EVIDENCE"

  "$@" 2>&1 | tee -a "$EVIDENCE"
  local rc=${PIPESTATUS[0]}
  if (( rc != 0 )); then
    printf '[Command failed, exit code %s]\n' "$rc" | tee -a "$EVIDENCE"
  fi
}

# Run a SQL statement with formatted (non-tuples-only) output.
evidence_sql() {
  printf '\nSQL: %s\n' "$1" | tee -a "$EVIDENCE"

  psql -X -w -P pager=off -p "$PORT" -d edb -v ON_ERROR_STOP=1 -c "$1" 2>&1 \
    | tee -a "$EVIDENCE"
  local rc=${PIPESTATUS[0]}
  if (( rc != 0 )); then
    printf '[SQL query failed, exit code %s]\n' "$rc" | tee -a "$EVIDENCE"
  fi
}

# =============================================================================
# Pre-flight
# =============================================================================
if ! command -v psql >/dev/null 2>&1; then
  echo 'psql not found in PATH' >&2
  exit 2
fi

DATA=$(query 'SHOW data_directory;' || true)
HBA=$(query 'SHOW hba_file;' || true)

section 'Host and PostgreSQL'
printf 'Host: %s\nPort: %s\nData: %s\nHBA: %s\n' \
  "$HOST" "$PORT" "$DATA" "$HBA" >> "$DETAILS"

# =============================================================================
# Checks 1-10
# =============================================================================

# 1. Security hardening (pg_hba.conf)
check_security_hardening() {
  if [[ -n "$HBA" && -r "$HBA" ]]; then
    if grep -Eq '^[[:space:]]*host[[:space:]]+all[[:space:]]+all[[:space:]]+0\.0\.0\.0/0[[:space:]]+reject' "$HBA"; then
      record 1 REVIEW 'HBA contains catch-all reject; inspect preceding rules and encryption policy'
    else
      record 1 REVIEW 'Review pg_hba.conf ordering, allowed CIDRs, auth methods, and hardening baseline'
    fi
    # Save active (non-comment, non-blank) HBA lines for review.
    grep -Ev '^([[:space:]]*#|[[:space:]]*$)' "$HBA" >> "$DETAILS" || true
  else
    record 1 FAIL 'Cannot read active pg_hba.conf'
  fi
}

# 2. PostgreSQL service and database access
check_service_and_access() {
  section 'Service and access'

  local svc_status sql_status
  if systemctl is-active --quiet "$SERVICE"; then svc_status=PASS; else svc_status=FAIL; fi
  if query 'SELECT 1;' | grep -qx 1;          then sql_status=PASS; else sql_status=FAIL; fi

  if [[ "$svc_status" == PASS && "$sql_status" == PASS ]]; then
    record 2 PASS 'Service active and SQL connection successful'
  else
    record 2 FAIL "Service=$svc_status SQL=$sql_status (check peer auth and PGUSER)"
  fi
}

# 3. Commvault backups (cannot be proven locally)
check_commvault() {
  section 'Commvault'

  if pgrep -af 'cvd|cvfwd|commvault' >> "$DETAILS" 2>&1; then
    record 3 MANUAL 'Local Commvault-related process found; verify client registration and latest successful backup in CommCell'
  else
    record 3 MANUAL 'No recognizable Commvault process; verify agent and backups in CommCell'
  fi
}

# 4. Splunk forwarder
check_splunk() {
  section 'Splunk'

  # [s]plunkd keeps pgrep from matching its own command line.
  if pgrep -af '[s]plunkd' >> "$DETAILS" 2>&1; then
    record 4 PASS 'splunkd process found; verify recent events are searchable in Splunk'
  else
    record 4 FAIL 'splunkd process not found'
  fi
}

# 5. SolarWinds DPA (cannot be proven locally)
check_solarwinds_dpa() {
  section 'SolarWinds DPA'
  record 5 MANUAL 'Verify instance registration, status, and recent metrics in SolarWinds DPA; local server cannot prove this'
}

# 6. SSL/TLS
check_ssl_tls() {
  section 'SSL/TLS'

  local ssl_setting tls_info
  ssl_setting=$(query 'SHOW ssl;' || true)

  if [[ "$ssl_setting" != on ]]; then
    record 6 FAIL "PostgreSQL ssl=$ssl_setting"
    return
  fi

  tls_info=$(psql -X -w -p "$PORT" -d edb -v ON_ERROR_STOP=1 -At \
    -c 'SELECT ssl,version,cipher FROM pg_stat_ssl WHERE pid=pg_backend_pid();' \
    2>>"$DETAILS" || true)

  if [[ "$tls_info" == t\|* ]]; then
    record 6 PASS "SSL on; current connection: $tls_info"
  else
    record 6 REVIEW 'SSL enabled but this connection is not confirmed encrypted; test TCP with sslmode=require and verify pg_hba.conf'
  fi
}

# 7. Guardium (Production/DR only)
check_guardium() {
  if ! is_prod_dr; then
    section 'Guardium (Not Applicable)'
    record 7 N/A "Not applicable in $ENVIRONMENT; Guardium applies to Production/DR"
    return
  fi

  section 'Guardium (Production/DR)'
  if pgrep -afi 'guardium|guard_tap|guardapi|gim' >> "$DETAILS" 2>&1; then
    record 7 REVIEW 'Guardium-related process found; confirm agent and collector connectivity'
  else
    record 7 FAIL 'No recognizable Guardium process detected on Production/DR server'
  fi
}

# 8. EFM and replication (Production/DR only)
check_efm_replication() {
  if ! is_prod_dr; then
    section 'EFM and replication (Not Applicable)'
    record 8 N/A "Not applicable in $ENVIRONMENT; EFM applies to Production/DR"
    return
  fi

  section 'EFM and replication (Production/DR)'

  if ! systemctl is-active --quiet "$EFM_SERVICE"; then
    record 8 FAIL 'EFM service is not active on Production/DR server'
    return
  fi

  if [[ ! -x "$EFM_BIN" ]]; then
    record 8 REVIEW 'EFM active but EFM binary path not found'
    return
  fi

  local cluster_status
  cluster_status=$("$EFM_BIN" cluster-status "$EFM_CLUSTER" 2>&1 || true)
  printf '%s\n' "$cluster_status" >> "$DETAILS"

  if grep -qi 'standby database(s) in sync with primary' <<< "$cluster_status"; then
    record 8 PASS 'EFM active; cluster reports standby in sync'
  else
    record 8 REVIEW 'EFM active; inspect cluster-status and replication lag'
  fi
}

# 9. DBPortal inventory (export only; verification is manual)
check_dbportal_inventory() {
  section 'DBPortal inventory'

  {
    printf 'host=%s\nport=%s\ninstance=enterprisedb\n' "$HOST" "$PORT"
    query "SELECT current_setting('server_version');" | sed 's/^/version=/'
    query 'SELECT datname FROM pg_database WHERE datallowconn ORDER BY datname;' \
      | sed 's/^/database=/'
  } > "$INVENTORY"
  chmod 600 "$INVENTORY"

  record 9 MANUAL 'Inventory exported; verify host, instance, databases, and application in DBPortal (no writes)'
}

# 10. Account profiles
check_account_profiles() {
  section 'Account profiles'

  if query 'SELECT 1 FROM pg_roles LIMIT 1;' >/dev/null; then
    record 10 REVIEW 'Role inventory available (see \du in report evidence); compare EDB profile assignments with approved baseline'
  else
    record 10 FAIL 'Cannot retrieve role inventory'
  fi
}

run_checks() {
  check_security_hardening
  check_service_and_access
  check_commvault
  check_splunk
  check_solarwinds_dpa
  check_ssl_tls
  check_guardium
  check_efm_replication
  check_dbportal_inventory
  check_account_profiles
}

# =============================================================================
# Evidence capture (full command output for each checklist item, read-only)
# =============================================================================
collect_evidence() {
  evidence_section '1. SECURITY HARDENING'
  evidence_run psql -X -w -P pager=off -p "$PORT" -d edb -c 'SHOW hba_file;'
  if [[ -n "$HBA" && -r "$HBA" ]]; then evidence_run cat "$HBA"; fi
  evidence_sql 'SHOW password_encryption;'
  evidence_sql 'SELECT line_number,type,database,user_name,address,auth_method,error FROM pg_hba_file_rules ORDER BY line_number;'

  evidence_section '2. POSTGRESQL SERVICE AND DATABASE ACCESS'
  evidence_run systemctl status "$SERVICE" --no-pager -l
  evidence_run psql -X -w -P pager=off -p "$PORT" -d edb -c '\l'

  evidence_section '3. COMMVAULT BACKUPS — EXTERNAL CONFIRMATION REQUIRED'
  evidence_run pgrep -af 'cvd|cvfwd|commvault'

  evidence_section '4. SPLUNK FORWARDER'
  evidence_run pgrep -af '[s]plunkd'

  evidence_section '5. SOLARWINDS DPA — EXTERNAL CONFIRMATION REQUIRED'

  evidence_section '6. SSL/TLS'
  evidence_sql 'SHOW ssl;'
  evidence_sql 'SHOW ssl_cert_file;'
  evidence_sql 'SHOW ssl_key_file;'
  evidence_sql 'SELECT ssl,version,cipher FROM pg_stat_ssl WHERE pid=pg_backend_pid();'

  if is_prod_dr; then
    evidence_section '7. GUARDIUM (PRODUCTION/DR)'
    evidence_run pgrep -afi 'guardium|guard_tap|guardapi|gim'

    evidence_section '8. EFM REPLICATION (PRODUCTION/DR)'
    evidence_run systemctl status "$EFM_SERVICE" --no-pager -l
    if [[ -x "$EFM_BIN" ]]; then evidence_run "$EFM_BIN" cluster-status "$EFM_CLUSTER"; fi
    evidence_sql 'SELECT pg_is_in_recovery();'
  else
    evidence_section '7. GUARDIUM'
    printf 'N/A - Guardium is not required in %s\n' "$ENVIRONMENT" | tee -a "$EVIDENCE"
    evidence_section '8. EFM REPLICATION'
    printf 'N/A - EFM is not required in %s\n' "$ENVIRONMENT" | tee -a "$EVIDENCE"
  fi

  evidence_section '9. DBPORTAL INVENTORY — EXTERNAL CONFIRMATION REQUIRED'
  evidence_run cat "$INVENTORY"

  evidence_section '10. ACCOUNT PROFILE STATUS'
  evidence_run psql -X -w -P pager=off -p "$PORT" -d edb -c '\du'
}

# =============================================================================
# HTML report
# =============================================================================

# Step 1: results.tsv -> HTML summary table (needs gawk for strftime).
render_html_summary() {
  export HOST PORT ENVIRONMENT

  local awk_program
  awk_program=$(cat <<'AWK'
function esc(x) {
  gsub(/&/, "\\&amp;", x)
  gsub(/</, "\\&lt;",  x)
  gsub(/>/, "\\&gt;",  x)
  gsub(/"/, "\\&quot;", x)
  return x
}

BEGIN {
  print "<!doctype html><html><head><meta charset=\"UTF-8\"><style>"
  print "body{font-family:Arial,sans-serif;color:#222}"
  print "table{border-collapse:collapse;width:100%}"
  print "td,th{padding:9px;border:1px solid #ccc;text-align:left}"
  print "th{background:#16324f;color:white}"
  print ".PASS{color:green}.FAIL{color:#b00}.MANUAL,.REVIEW{color:#9a6700}.NA{color:#777}"
  print "</style></head><body>"

  print "<h2>EDB PostgreSQL Post-Build Validation</h2>"
  print "<p><b>Host:</b> "        esc(ENVIRON["HOST"])        \
        "<br><b>Environment:</b> " esc(ENVIRON["ENVIRONMENT"]) \
        "<br><b>Port:</b> "        esc(ENVIRON["PORT"])        \
        "<br><b>Date:</b> "        strftime("%Y-%m-%d %H:%M:%S %Z") "</p>"

  print "<table><tr><th>Check</th><th>Status</th><th>Details</th></tr>"
}

NR > 1 {
  status = $2
  # Any unrecognised status is shown as REVIEW. (String match, because a
  # literal "/" would terminate an awk regex constant.)
  if (status !~ "^(PASS|FAIL|REVIEW|MANUAL|N/A)$") status = "REVIEW"

  css_class = (status == "N/A") ? "NA" : status
  print "<tr><td>" esc($1) "</td>" \
        "<td class=\"" css_class "\"><b>" status "</b></td>" \
        "<td>" esc($3) "</td></tr>"
  count[status]++
}

END {
  print "</table>"
  printf "<p><b>Summary:</b> PASS %d | FAIL %d | REVIEW %d | MANUAL %d | N/A %d</p>\n", \
         count["PASS"]+0, count["FAIL"]+0, count["REVIEW"]+0, \
         count["MANUAL"]+0, count["N/A"]+0
  print "<p><i>Manual/review items are not passes. Verify Commvault backup success, SolarWinds registration and DBPortal registration separately. Command evidence is included in this report.</i></p></body></html>"
}
AWK
)

  awk -F '\t' "$awk_program" "$REPORT" > "$HTML_REPORT"
}

# Step 2: append captured command output to the HTML report.
append_evidence_to_html() {
  python3 - "$HTML_REPORT" "$EVIDENCE" <<'PYHTML'
import html
import sys
from pathlib import Path

report_path = Path(sys.argv[1])
evidence_path = Path(sys.argv[2])

report_html = report_path.read_text(encoding="utf-8")
evidence_text = evidence_path.read_text(encoding="utf-8", errors="replace")

evidence_block = (
    "<h2>Detailed Command Evidence</h2>"
    "<p>Read-only command outputs captured on the server. "
    "External systems require independent verification.</p>"
    '<pre style="white-space:pre-wrap;overflow-wrap:anywhere;'
    "background:#f5f7fa;padding:12px;border:1px solid #ccc;font-size:12px\">"
    + html.escape(evidence_text)
    + "</pre>"
)

report_path.write_text(
    report_html.replace("</body></html>", evidence_block + "</body></html>"),
    encoding="utf-8",
)
PYHTML
}

build_html_report() {
  render_html_summary
  append_evidence_to_html
  chmod 600 "$HTML_REPORT"
}

# =============================================================================
# Email
# =============================================================================
has_newline() { [[ "$1" == *$'\n'* || "$1" == *$'\r'* ]]; }

# Emit the full RFC 822 message (headers + HTML body) on stdout.
compose_email() {
  printf 'To: %s\n' "$EMAIL_TO"
  [[ -z "$EMAIL_FROM" ]] || printf 'From: %s\n' "$EMAIL_FROM"
  printf 'Subject: PostgreSQL Post-Build Validation - %s\n' "$HOST"
  printf 'MIME-Version: 1.0\n'
  printf 'Content-Type: text/html; charset=UTF-8\n\n'
  cat "$HTML_REPORT"
}

send_email() {
  [[ "$SEND_EMAIL" == yes ]] || return 0

  if ! command -v sendmail >/dev/null 2>&1; then
    echo "WARNING: sendmail unavailable; HTML report saved at $HTML_REPORT" >&2
    return
  fi

  # Guard against header injection.
  if has_newline "$EMAIL_TO" || has_newline "$EMAIL_FROM" || has_newline "$HOST"; then
    echo 'ERROR: invalid email header' >&2
    return
  fi

  if compose_email | sendmail -t -oi; then
    echo "HTML email submitted to local mail transport for $EMAIL_TO"
  else
    echo "WARNING: sendmail failed; HTML report saved at $HTML_REPORT" >&2
  fi
}

# =============================================================================
# Main
# =============================================================================
main() {
  run_checks
  collect_evidence

  printf '\nOutputs: %s\n' "$OUTDIR"
  printf 'Full evidence is embedded in: %s\n' "$HTML_REPORT"
  printf 'NOTE: REVIEW and MANUAL are not PASS. Check the evidence in %s\n' "$HTML_REPORT"

  build_html_report
  send_email
}

main "$@"
